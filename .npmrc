# Turn package.json's `engines.node` into a real gate rather than a warning:
# with this set, both `npm install` and `npm ci` fail with EBADENGINE on a Node
# older than the declared floor. Without it npm only warns and installs anyway,
# so a contributor on the wrong Node breaks later and more confusingly.
# Escape hatch for a one-off: `npm ci --engine-strict=false`.
engine-strict=true

# NOTE: `.npmrc` is NOT on electron-builder's excluded-names list (unlike
# .gitignore / .npmignore). It is kept out of the packaged app only by the
# explicit `files` allowlist in package.json. Never put a registry token or any
# other credential in this file.
