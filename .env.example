GEMINI_API_KEY=your_google_ai_studio_key

# That's it for chat — Iris talks to you with just the Gemini key above.
# Everything below is optional and mostly for the Claude build pipeline,
# which Iris enables once a Claude credential is configured (Claude Code
# itself ships inside the app — there is nothing to install)
# installed (see README's "Claude pipeline" section).

# Optional overrides
IRIS_USER_NAME=there
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Zephyr

# Subscription token — required for the shaping verbs (a stateful Agent SDK
# session). It does NOT reuse your interactive `claude` login. One-shot runs are
# unaffected either way. Generate a one-time subscription OAuth token:
#   claude setup-token
# then paste it here so that usage bills against your Claude subscription
# instead of the per-token API:
# CLAUDE_CODE_OAUTH_TOKEN=your_setup_token_value
#
# You can also paste it into Settings -> Claude pipeline -> Subscription
# token, which writes this same key for you (the only option in a packaged
# build, where this file lives at ~/.myiris/.env). Saving there closes any
# resident session so the new token applies on the next turn without restarting
# Iris; prior context is resumed, not lost.
#
# FOOTGUN: if ANTHROPIC_API_KEY is set anywhere in this environment, it
# outranks CLAUDE_CODE_OAUTH_TOKEN and silently switches usage to metered
# API billing. Iris strips ANTHROPIC_API_KEY from the live session's own
# environment, but do not set it here unless you intend to pay per token.
# ANTHROPIC_API_KEY is not used by Iris and should be left unset.

# Hands-free "Hey Iris" wake word (on-device ONNX, only listens while asleep).
# Default: on. Set to 0 to disable (also toggleable from Settings).
# IRIS_WAKE_WORD=1

# Wake-word sensitivity: classifier score a frame must clear to count toward a
# detection (0-1). Lower = more sensitive (more false wakes); higher = stricter
# (may miss quieter "Hey Iris"). Default 0.15 matches today's behavior.
# Also settable from Settings -> Wake word sensitivity (Strict 0.18 / Balanced
# 0.15 / Sensitive 0.11). A missing/non-numeric/out-of-range value falls back
# to the default.
# IRIS_WAKE_THRESHOLD=0.15

# Number of consecutive above-threshold inference evaluations (~200ms apart)
# required before a wake fires. Default 2 (~400ms of agreement) rejects an
# isolated score spike. Env-only, not exposed in Settings. Rollback: set to 1
# to reproduce the pre-hardening detection rule (single-frame threshold).
# IRIS_WAKE_CONSECUTIVE=2

# Enables wake-word score diagnostics (each fired wake's score and run length,
# plus rate-limited near-miss scores) to the renderer console, and opens
# DevTools so that console is reachable. Off by default; never records audio.
# IRIS_WAKE_DEBUG=0

# How long after Gemini's "go_to_sleep" tool call before Iris actually sleeps
# (gives the spoken goodbye time to play). Default: 3000 (ms).
# IRIS_SLEEP_DELAY_MS=3000

# Global hotkey that toggles the Glass HUD overlay (click-through, floats
# over your desktop) from anywhere, even while another app has focus.
# Default: Alt+Space. Electron accelerator syntax (e.g. "Control+Shift+H").
# IRIS_HUD_HOTKEY=Alt+Space

# Global hotkey that toggles listen-only mode: Iris goes completely silent and
# hears your machine's audio as well as the microphone, so you can let someone
# else ask you something — in the room or on a call — and then ask her about it
# afterwards. Nothing is written to disk; what she heard stays in the voice
# conversation, which is what you ask against. The Gemini session is never
# reconnected, on either transition. Reachable from anywhere, even while another
# app has focus. Default: Alt+L. Electron accelerator syntax.
# IRIS_LISTEN_HOTKEY=Alt+L

# How long listen-only mode stays engaged before it ends on its own, in minutes.
# Default 5, clamped to a ceiling of 15. The mode disengages itself at that
# deadline exactly as if you had toggled it off, and the deadline is absolute:
# continued speech does not extend it. The countdown is shown on screen, since
# Iris is silent and cannot warn you by voice.
# There is deliberately no unbounded setting — 0, a negative number and anything
# unparseable all mean the default rather than "forever". Five minutes is what
# the mode is for, and it is short enough that the whole engagement is still in
# the voice session's context when you ask about it.
# IRIS_LISTEN_MAX_MINUTES=5

# The system-audio half of listen-only mode. On by default: engaging the mode
# captures what the machine is playing (macOS 14.2+) and mixes it into the
# single stream sent to Gemini, so Iris hears the remote participants of a call
# rather than only the room. macOS shows its screen-recording indicator for the
# whole engagement, even though Iris captures no video.
# Set to 0 to disable it entirely — engaging the mode then only silences Iris,
# exactly as it did before this existed: no capture and no recording indicator.
# The listening window above still bounds the engagement either way.
# IRIS_SYSTEM_AUDIO=0

# How loudly captured system audio sits against the microphone in that mix,
# 0–1. Below unity so loud playback does not bury your own voice; the
# microphone's gain is derived from this so the summed signal keeps headroom
# rather than clipping. Default: 0.7.
# IRIS_SYSTEM_AUDIO_GAIN=0.7

# Global hotkey that wakes Iris (starts the voice session) from anywhere, even
# while another app has focus — and with the deck closed, in which case a
# window is created for you. Default: Alt+Shift+W. Electron accelerator syntax.
# Must be modifier-qualified: a bare letter would be swallowed system-wide.
# IRIS_WAKE_HOTKEY=Alt+Shift+W

# Global hotkey that puts Iris to sleep (ends the voice session) from
# anywhere, even while another app has focus. Default: Alt+Shift+S. Electron
# accelerator syntax. If a hotkey collides with another app's and cannot be
# registered, Iris logs it and keeps going — wake stays reachable by tray,
# wake word, and the in-app control.
# IRIS_SLEEP_HOTKEY=Alt+Shift+S

# Iris supports macOS only and refuses to launch on other platforms by
# default. Developer escape hatch for deliberate non-macOS runs (e.g. Linux):
# IRIS_ALLOW_ANY_PLATFORM=1

# Lets Gemini use built-in Google Search for quick facts/lookups. OFF by
# default because it's a BILLED Gemini feature — on a free-tier key, turning
# this on disconnects the Live session immediately with a 1011 quota error.
# Only enable with a paid Gemini key. Accepts 1/true/yes/on (case-insensitive);
# also toggleable from Settings -> Gemini API key, which writes this same key.
# IRIS_ENABLE_GOOGLE_SEARCH=true

# Ambient session capture: opt-in retention of conversation TEXT (never audio)
# into the notes vault, so the second brain accumulates from what you already
# talk about. Off by default and toggled from the interface, which shows an
# indicator with a stop affordance whenever it is actually recording. This
# variable can only TIGHTEN that default — set it to "off" to force the
# toggle unavailable and hidden on a machine where this must not be possible.
# There is deliberately no value that force-*enables* it.
# IRIS_AMBIENT_CAPTURE=off

# ===== Claude pipeline — optional, auto-detected =====
# Everything from here down only matters if you want the build
# pipeline. Install the Claude Code CLI (`claude --version` works) and Iris
# picks it up automatically — no flag needed to turn it on.

# Directory Claude works in (also scopes its saved sessions):
# IRIS_CLAUDE_CWD=/Users/you/.myiris/workspace
# Permission mode for headless runs. Default is bypassPermissions (fully
# autonomous — Claude can run any tool without asking). Set acceptEdits or
# plan for a more restricted worker:
# IRIS_CLAUDE_PERMISSION_MODE=bypassPermissions
# There is deliberately no setting for the Claude or OpenSpec binary: both ship
# inside the app. Pointing Iris at a system install would restore the coupling
# this design removed, and would run someone else's binary under bypassPermissions.

# The skills and /opsx commands the personas invoke ship inside the app
# as a Claude Code plugin (resources/iris-plugin) and are passed to the Agent
# SDK per run; the personas are passed by value. Nothing is installed into your
# own ~/.claude, and nothing is read from it: settingSources excludes the user
# scope, and CLAUDE_CONFIG_DIR is pinned to ~/.myiris/claude-home so the inputs
# that ignore settingSources (session transcripts, the global .claude.json,
# auto-memory) land there too. There is deliberately no setting to override
# that — the only place worth pointing it at is the ~/.claude this protects.
#
# Consequence: Iris cannot use a `claude /login` session you set up in your
# terminal. It needs its own credential, which is what the two variables at the
# top of this file are for.

# How long a live session waits for a voice answer to a mid-turn
# question (AskUserQuestion) before applying its own recommended option.
# Default: 300000 (5 minutes).
# IRIS_PO_QUESTION_TIMEOUT_MS=300000

# How long the run holding the execution slot may go without producing a
# progress signal (a tool call, tool result, or activity line) before it is
# terminated automatically and the slot released. This bounds silence, not
# total runtime — a long but healthy run is never killed for being long, and
# a run paused on a live question (see IRIS_PO_QUESTION_TIMEOUT_MS above) is
# never counted as idle. Default: 1800000 (30 minutes). Rollback: set this
# high enough to never fire (no code change needed).
# IRIS_RUN_IDLE_TIMEOUT_MS=1800000

# Ceilings on how far a single run may go before it is stopped: agentic turns,
# and estimated spend in USD. These are a runaway guard, not a quota — a
# voice-dispatched run executes with permission checks bypassed, on your own
# credential, and without these there is nothing bounding either. A run stopped
# by a ceiling is reported as "limited", NOT as a failure, and its output names
# which ceiling fired and how to raise it.
#
# Both apply to every verb at once. Built-in defaults, set from measured runs at
# roughly 4-6x headroom (a representative propose turn took 28 turns / $0.97,
# an implementation run 29 turns / $0.78):
#   stateful     150 turns, $6.00   (the shaping verbs' shared live session)
#   worker       150 turns, $5.00   (execute, finish)
#   light         60 turns, $2.00   (investigate, review, capture_learning)
# IRIS_CLAUDE_MAX_TURNS=150
# IRIS_CLAUDE_MAX_BUDGET_USD=5

# Fraction of the spend ceiling at which a still-running run warns, so a long
# run becomes visible before it stops rather than after. Must be below 1 (a
# value of 1 or more could only fire when the ceiling itself does, which is not
# a warning) — anything else falls back to the default. Default: 0.75.
# IRIS_CLAUDE_BUDGET_WARN_FRACTION=0.75

# How often a chatty run's free-text activity log is flushed to the renderer,
# coalescing bursts of activity lines into one update per interval. Does not
# affect the step timeline (tool_start/tool_end stay realtime) or the idle
# watchdog (heartbeat still fires per line). Default: 150 (ms).
# IRIS_ACTIVITY_EMIT_INTERVAL_MS=150

# Hard deadline for app quit's teardown (closing the Gemini Live socket,
# ending one-shot runs, closing resident sessions) before the app force-exits
# anyway. Default: 8000 (8 seconds).
# IRIS_SHUTDOWN_DEADLINE_MS=8000

# Pre-dispatch review gate. Three settings:
#   verb   (default) park what the verb registry declares as reviewed — the two
#          verbs that write to your project (execute, finish) on every call, and
#          the call that OPENS a shaping conversation. Reading and reviewing
#          dispatch straight away.
#   always park every request before any Claude tokens are spent.
#   never  dispatch everything immediately.
# The previous boolean values still work and are not reinterpreted: 1/true/on
# means `always`, 0/false/off means `never`. Settable from the UI (PipelineBar),
# never by voice; whichever value is set here is only the startup default — the
# control persists back to this same key.
# IRIS_PROMPT_REVIEW=verb

# How long a parked review waits for Approve/Cancel before it is cancelled
# (never auto-approved — auto-sending an unreviewed brief is exactly what the
# gate prevents). Default: 300000 (5 minutes).
# IRIS_PROMPT_REVIEW_TIMEOUT_MS=300000

# Model defaults per persona group (choose from: claude-opus-5,
# claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5-20251001). STATEFUL covers
# the two shaping verbs (they share one live conversation); STATELESS covers
# execute, finish, investigate, review, and capture_learning. Only used when the
# workstream has no model chosen yet — a workstream choice always outranks
# these, and each verb's own registry default applies if neither is set
# (shaping: Opus 5, execute/finish/investigate: Sonnet 5, review: Opus 5,
# capture_learning: Haiku 4.5).
#
# IRIS_PO_MODEL / IRIS_DEV_MODEL are still read as aliases for these two, so an
# existing .env keeps working.
# IRIS_STATEFUL_MODEL=claude-opus-5
# IRIS_STATELESS_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Diagnostic log
# ---------------------------------------------------------------------------
# Iris writes a JSONL diagnostic log to ~/.myiris/logs/iris.log, rotated by
# size. It captures everything the main process prints, every internal event,
# and the renderer's own faults — which is the only record that survives a
# packaged build failing on somebody else's machine.
#
# Read it with:   tail -f ~/.myiris/logs/iris.log
# Filter it with: jq 'select(.level=="error")' ~/.myiris/logs/iris.log
#
# Credentials are masked before anything is written, from every source
# including output Iris did not produce itself. Redaction fails toward masking:
# a log slightly harder to read is recoverable, a leaked token in a bug report
# is not.

# Set to 0, off, or false to write nothing at all. Anything else — including a
# typo — leaves logging ON, deliberately: silently removing the thing you are
# relying on to explain a failure is the worst way this could fail.
# IRIS_LOG=1

# Minimum level written to the FILE: debug, info, warn, error. Default: debug,
# i.e. everything, in development AND production builds alike. The file is
# where you look after something went wrong, so what mattered cannot be decided
# before it happens. (This is deliberately unlike the camera preview's activity
# strip, whose depth does follow the build mode — that one is a glance.)
# IRIS_LOG_LEVEL=debug

# Rotate once the active file passes this many bytes. Default: 4194304 (4 MB).
# IRIS_LOG_MAX_BYTES=4194304

# How many rotated files to keep besides the active one. Default: 4.
# Total disk is therefore (IRIS_LOG_KEEP + 1) x IRIS_LOG_MAX_BYTES — 20 MB by
# default, and computable in advance rather than discovered from a full disk.
# IRIS_LOG_KEEP=4
